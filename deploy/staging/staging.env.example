# Environment of the KFin staging API container.
#
# The deploy workflow writes this file on the host from GitHub Environment
# secrets (mode 0600) and never prints its contents. Copy it by hand only when
# deploying without CI:
#
#   cp staging.env.example staging.env && chmod 600 staging.env && $EDITOR staging.env
#
# It deliberately holds only what the API needs. Compose and database settings
# live in db.env, so the admin and migration credentials never enter this
# container.
#
# Generate secrets with `openssl rand -hex 32`. Never commit the populated file;
# `deploy/staging/.gitignore` covers it.

DATABASE_POOL_MAX=5
IDEMPOTENCY_RETENTION_HOURS=24
AUTH_SECRET=
FINANCIAL_PREVIEW_SIGNING_KEY=
# Same-origin only; must stay empty.
AUTH_ALLOWED_ORIGINS=
# Production-parity cookie rules: the request arrives over HTTPS at Caddy.
AUTH_COOKIE_SECURE=true
HSTS_MAX_AGE_SECONDS=31536000

# No mail provider is configured yet. `STAGING_MODE=true` is the explicit,
# tested exception that lets the process boot with EMAIL_DELIVERY_ADAPTER=none;
# password reset cannot complete and the server logs a warning at boot. Delete
# both lines as soon as a provider exists.
EMAIL_DELIVERY_ADAPTER=none
STAGING_MODE=true

# Only for `STAGING_DB_MODE=managed` (an external PostgreSQL). With the default
# container database the Compose overlay sets DATABASE_URL and disables TLS.
# DATABASE_URL=postgresql://kfin_app:PASSWORD@db.staging.example:5432/kfin
# DATABASE_SSL_MODE=verify-full
