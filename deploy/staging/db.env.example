# Compose interpolation and database credentials for the staging host.
#
# Read by `docker compose --env-file db.env` and by the database container. It
# is NOT mounted into the API container: the admin and migration credentials
# must never be visible to the application process.
#
# The deploy workflow writes it (mode 0600) from GitHub Environment secrets.
# Passwords must be hex (`openssl rand -hex 24`): they are interpolated into a
# connection URL, where `@ : / # ?` would need escaping.

# `container` = PostgreSQL on this host (docker-compose.database.yml).
# `managed`   = external managed PostgreSQL (DATABASE_URL in staging.env).
STAGING_DB_MODE=container
STAGING_DB_NAME=kfin_staging

# Container mode only. The superuser is not published beyond 127.0.0.1.
STAGING_DB_ADMIN_PASSWORD=
KFIN_APP_PASSWORD=
KFIN_MIGRATOR_PASSWORD=
# Used by the invitation CLI only; empty provisions the role without a password.
KFIN_OPERATOR_PASSWORD=

# The edge subnet the API trusts as its reverse proxy. Must match
# docker-compose.yml and, if changed, `docker network rm kfin-staging-edge`.
KFIN_PROXY_CIDR=172.28.0.0/16
