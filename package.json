{
  "name": "kfin",
  "version": "0.1.0",
  "private": true,
  "description": "KFin financial foundation modular monolith",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.34.0 <11"
  },
  "scripts": {
    "build": "tsc -b --pretty false && node scripts/build-production.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run packages/database/test/*.integration.test.ts apps/api/test/*.integration.test.ts",
    "check": "corepack pnpm run evidence:check && corepack pnpm run evidence:test && corepack pnpm run sqlguard && corepack pnpm run sqlguard:test && corepack pnpm run typecheck && corepack pnpm run test",
    "api:dev": "corepack pnpm --filter @kfin/api dev",
    "api:start": "corepack pnpm --filter @kfin/api start",
    "db:migrate": "corepack pnpm --filter @kfin/database migrate",
    "db:migrate:artifact": "node apps/api/dist/migrate.bundle.mjs",
    "db:provision-roles": "corepack pnpm --filter @kfin/database provision-roles",
    "db:verify-app-role": "corepack pnpm --filter @kfin/database verify-app-role",
    "backup:drill": "node scripts/operations/backup-restore-drill.mjs",
    "evidence:check": "node evidence/spec-fin-02/scripts/check.mjs",
    "evidence:test": "node --test evidence/spec-fin-02/test/*.test.mjs",
    "sqlguard": "node tools/sql-guard/guard.mjs",
    "sqlguard:test": "node --test tools/sql-guard/guard.test.mjs",
    "evidence:setup": "node evidence/spec-fin-02/src/cli.mjs setup",
    "evidence:reset": "node evidence/spec-fin-02/src/cli.mjs reset",
    "evidence:drop": "node evidence/spec-fin-02/src/cli.mjs drop",
    "evidence:run": "node evidence/spec-fin-02/src/cli.mjs run",
    "evidence:case": "node evidence/spec-fin-02/src/cli.mjs run",
    "web:dev": "corepack pnpm --filter @kfin/web dev",
    "invite:provision": "tsx apps/api/tools/provision-invitation.ts",
    "invite:provision:artifact": "node apps/api/dist/provision-invitation.bundle.mjs",
    "web:build": "corepack pnpm --filter @kfin/web build",
    "start": "corepack pnpm --filter @kfin/api start",
    "smoke:production": "node scripts/smoke/production-smoke.mjs",
    "smoke:https": "node scripts/smoke/https-proxy-smoke.mjs",
    "verify:production-install": "node scripts/verify-production-install.mjs",
    "image:build": "docker build --build-arg GIT_COMMIT=$(git rev-parse HEAD) -t kfin-runtime:local ."
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
