# Never commit a populated .env file.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://kfin_app:replace-me@localhost:5432/kfin
# Used only by `pnpm db:migrate`; provision this as a separate migration role.
MIGRATION_DATABASE_URL=postgresql://kfin_migrator:replace-me@localhost:5432/kfin
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
# Required deployment input. Set only to an approved retention value.
IDEMPOTENCY_RETENTION_HOURS=
# Exactly 32 random bytes encoded as 64 hexadecimal characters.
FINANCIAL_PREVIEW_SIGNING_KEY=
# Trusted Private Beta access (Milestone 04).
# Server secret for keyed auth digests (invitation codes, OTP/reset secrets,
# session tokens, CSRF tokens, abuse counters). Never reuse another key.
# Exactly 32 random bytes encoded as 64 hexadecimal characters.
AUTH_SECRET=
# UNSUPPORTED and must stay empty. KFin has no credentialed CORS layer, so the
# browser client must be served from the API host (same-origin); setting any
# origin here is rejected at startup instead of silently relaxing CSRF defense.
AUTH_ALLOWED_ORIGINS=
# Production MUST keep secure cookies enabled: a production start with this set
# to false is refused. Disable only for local HTTP development over plain HTTP.
AUTH_COOKIE_SECURE=true
# Vendor-neutral delivery only; provider selection is Phase 6 (OQ-17).
#   none   (default) no provider: every message is reported as failed.
#   memory  keeps the message in process memory only; nothing can read it from a
#           browser, so a local registration cannot be completed with this alone.
#   file    local development sink: writes one JSON file per message (mode 0600)
#           into EMAIL_OUTBOX_DIR so a developer can read a one-time code. Refused
#           when NODE_ENV=production, because it puts an OTP/reset secret on disk.
# See docs/development/LOCAL-DEVELOPMENT.md.
EMAIL_DELIVERY_ADAPTER=none
# Required only when EMAIL_DELIVERY_ADAPTER=file. Local machine only; delete the
# directory when finished and never point it at a shared or backed-up location.
EMAIL_OUTBOX_DIR=
