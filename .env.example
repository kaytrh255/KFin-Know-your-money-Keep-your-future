# Never commit a populated .env file.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://kfin_app:replace-me@localhost:5432/kfin
# Used only by `pnpm db:migrate`; provision this as a separate migration role.
MIGRATION_DATABASE_URL=postgresql://kfin_migrator:replace-me@localhost:5432/kfin
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
# Required deployment input. Set only to an approved retention value.
IDEMPOTENCY_RETENTION_HOURS=
# Exactly 32 random bytes encoded as 64 hexadecimal characters.
FINANCIAL_PREVIEW_SIGNING_KEY=
# Trusted Private Beta access (Milestone 04).
# Server secret for keyed auth digests (invitation codes, OTP/reset secrets,
# session tokens, CSRF tokens, abuse counters). Never reuse another key.
# Exactly 32 random bytes encoded as 64 hexadecimal characters.
AUTH_SECRET=
# Exact additional browser origins allowed to make state-changing requests.
# Same-origin is derived from the request Host; a credentialed wildcard is never allowed.
AUTH_ALLOWED_ORIGINS=
# Production MUST keep secure cookies enabled. Disable only for local HTTP development.
AUTH_COOKIE_SECURE=true
# Vendor-neutral delivery only; provider selection is Phase 6 (OQ-17).
EMAIL_DELIVERY_ADAPTER=none
